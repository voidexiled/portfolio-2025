---
import { Image } from "astro:assets";
import { ArrowUpRight } from "lucide-astro";
import { portfolioCopy } from "@/data/portfolio-copy";
import { projects } from "@/data/projects";

const featuredProjects = projects.filter((project) => project.featured).sort((a, b) => a.order - b.order);
---

<section id="work" class="portfolio-section" aria-labelledby="work-heading">
  <div class="portfolio-section-heading portfolio-section-heading-wide">
    <div>
      <p class="portfolio-eyebrow">01 / selected work</p>
      <h2 id="work-heading">{portfolioCopy.sections.work}</h2>
    </div>
    <p class="portfolio-section-intro">A selection of product work, prototypes, and technical systems.</p>
  </div>

  <div class="portfolio-project-grid">
    {
      featuredProjects.map((project) => (
        <article class="portfolio-project-card">
          <div class="portfolio-project-image-frame">
            <Image
              src={project.image}
              width={1200}
              height={675}
              fit="cover"
              position="center"
              format="webp"
              quality={80}
              loading="lazy"
              alt={`${project.title} project screenshot`}
            />
          </div>
          <div class="portfolio-project-content">
            <h3 class="portfolio-project-title">{project.title}</h3>
            <p>{portfolioCopy.projects[project.id as keyof typeof portfolioCopy.projects]}</p>
            <p class="portfolio-project-stack">{project.portfolioStack.join(" · ")}</p>
            <div class="portfolio-project-links">
              <a href={project.repoURL} target="_blank" rel="noopener noreferrer">
                Repository <ArrowUpRight size={15} aria-hidden="true" />
              </a>
              {project.liveURL && (
                <a href={project.liveURL} target="_blank" rel="noopener noreferrer">
                  Live demo <ArrowUpRight size={15} aria-hidden="true" />
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
