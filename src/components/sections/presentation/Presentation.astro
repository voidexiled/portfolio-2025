---
import { ArrowUpRight, Github, Linkedin, Mail, MapPin } from "lucide-astro";
import { portfolioCopy } from "@/data/portfolio-copy";
import { profile } from "@/data/profile";
---

<section class="portfolio-hero" aria-labelledby="hero-heading">
  <div class="portfolio-hero-copy">
    <p class="portfolio-eyebrow">Frontend Engineer · Product-focused engineering</p>
    <h1 id="hero-heading">{profile.name}</h1>
    <p class="portfolio-hero-role">{profile.role}</p>
    <p class="portfolio-hero-lede">{portfolioCopy.hero.headline}</p>
    <p class="portfolio-hero-secondary">{portfolioCopy.hero.secondary}</p>

    <div class="portfolio-hero-actions">
      <a class="portfolio-button portfolio-button-primary" href="/cv">
        {portfolioCopy.hero.viewResume}
        <ArrowUpRight size={17} aria-hidden="true" />
      </a>
      <a class="portfolio-button portfolio-button-secondary" href={profile.github} target="_blank" rel="noopener noreferrer">
        {portfolioCopy.hero.viewGithub}
        <Github size={17} aria-hidden="true" />
      </a>
    </div>

    <div class="portfolio-hero-links" aria-label="Additional contact links">
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile">
        <Linkedin size={16} aria-hidden="true" />
        <span>{portfolioCopy.hero.linkedin}</span>
      </a>
      <a href={`mailto:${profile.email}`} aria-label={`Email ${profile.name}`}>
        <Mail size={16} aria-hidden="true" />
        <span>{portfolioCopy.hero.email}</span>
      </a>
    </div>
  </div>

  <aside class="portfolio-hero-aside" aria-label="Availability and location">
    <img
      class="portfolio-avatar"
      src="/jesusjalomo.webp"
      width="80"
      height="80"
      alt={profile.name}
    />
    <div class="portfolio-hero-meta">
      <p><MapPin size={16} aria-hidden="true" /> {portfolioCopy.hero.location}</p>
      <p><span class="portfolio-availability-dot" aria-hidden="true"></span> {portfolioCopy.hero.availability}</p>
    </div>
  </aside>
</section>
