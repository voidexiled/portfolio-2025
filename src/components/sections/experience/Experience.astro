---
import { portfolioCopy } from "@/data/portfolio-copy";
import { experience } from "@/data/experience";

const orderedExperience = [...experience];
const monthLabels: Record<string, string> = {
  "01": "Jan",
  "02": "Feb",
  "03": "Mar",
  "04": "Apr",
  "05": "May",
  "06": "Jun",
  "07": "Jul",
  "08": "Aug",
  "09": "Sep",
  "10": "Oct",
  "11": "Nov",
  "12": "Dec",
};

const formatDate = (value: string) => {
  const [year, month] = value.split("-");
  return month ? `${monthLabels[month]} ${year}` : year;
};

const formatDateRange = (start: string, end?: string | null) =>
  `${formatDate(start)} - ${end ? formatDate(end) : "Present"}`;
---

<section id="experience" class="portfolio-section" aria-labelledby="experience-heading">
  <div class="portfolio-section-heading">
    <p class="portfolio-eyebrow">02 / background</p>
    <h2 id="experience-heading">{portfolioCopy.sections.experience}</h2>
  </div>

  <div class="portfolio-experience-list">
    {
      orderedExperience.map((entry, index) => {
        const copy = portfolioCopy.experience[entry.id as keyof typeof portfolioCopy.experience];
        const isFeatured = index === 0;

        return (
          <article class:list={["portfolio-experience-entry", { "portfolio-experience-entry-featured": isFeatured }]}>
            <div class="portfolio-experience-marker" aria-hidden="true"></div>
            <div class="portfolio-experience-content">
              <div class="portfolio-experience-heading">
                <div>
                  {entry.id !== "independent" && <p class="portfolio-eyebrow">{entry.organization}</p>}
                  <h3>{copy.title}</h3>
                </div>
                <p class="portfolio-experience-meta">
                  <span>{formatDateRange(entry.start, entry.end)}</span>
                  <span>{entry.location}</span>
                </p>
              </div>
              <p class="portfolio-experience-summary">{copy.summary}</p>
              {"currentWork" in copy && <p class="portfolio-experience-current">{copy.currentWork}</p>}
            </div>
          </article>
        );
      })
    }
  </div>
</section>
