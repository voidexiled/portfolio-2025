---
import { ClientRouter } from "astro:transitions";

type Props = {
  title: string;
  description?: string;
  lang?: string;
};

const { title, description, lang } = Astro.props;
---

<!doctype html>
<html lang={lang ?? "es"} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href="https://jesusjalomo.vercel.app/" />
    <!-- <link
      rel="alternate"
      hreflang="es"
      href="https://jesusjalomo.vercel.app/es/"
    />
    <link
      rel="alternate"
      hreflang="en"
      href="https://jesusjalomo.vercel.app/en/"
    /> -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="all" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {description && <meta name="description" content={description} />}
    <meta name="author" content="Francisco Jesus Jalomo Chavez" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="grid relative">
    <!-- <div
      class="absolute top-0 z-[-2] h-screen w-full bg-background bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    > -->

    <main class="container lg:px-20 pb-10 mx-auto">
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
